---
import { resolveNavLogoUrl } from '../lib/navLogo';

const SPACE_ID = 'yo5cnbbvoxyx';
const ACCESS_TOKEN = 'U5q6mGZBvntULz0tlWA-KnKvMIcDFuigHEuQBOu5kzo';
const CDA = `https://cdn.contentful.com/spaces/${SPACE_ID}/environments/master`;

async function fetchContentful(contentType, params = '') {
  try {
    const res = await fetch(`${CDA}/entries?content_type=${contentType}&include=2${params}`, {
      headers: { Authorization: `Bearer ${ACCESS_TOKEN}` }
    });
    if (!res.ok) return null;
    return await res.json();
  } catch { return null; }
}

async function fetchAllAssets() {
  try {
    const res = await fetch(`${CDA}/assets?limit=200`, {
      headers: { Authorization: `Bearer ${ACCESS_TOKEN}` }
    });
    if (!res.ok) return [];
    return (await res.json()).items || [];
  } catch { return []; }
}

function getAssetUrl(assets, assetId) {
  if (!assets || !assetId) return null;
  const asset = assets.find(a => a.sys.id === assetId);
  return asset ? `https:${asset.fields.file.url}` : null;
}

const [homepageData, testimonialsData, allAssets] = await Promise.all([
  fetchContentful('homepage'),
  fetchContentful('testimonial', '&limit=3'),
  fetchAllAssets(),
]);

const h = homepageData?.items?.[0]?.fields || {};
const siteName = h.siteName || 'StopLab';
const heroImageUrl = getAssetUrl(allAssets, h.heroImages?.[0]?.sys?.id)
  || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1600&q=80';

const navLogoUrl = resolveNavLogoUrl(h, allAssets);

const testimonials = testimonialsData?.items || [];
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{siteName} — Kiến Trúc & Nội Thất</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="description" content={h.contactDescription || 'Thiết kế và thi công kiến trúc, nội thất với tâm huyết'}>
  
  <!-- OG Meta Tags -->
  <meta property="og:title" content={`${siteName} — Kiến Trúc & Nội Thất`}>
  <meta property="og:description" content={h.contactDescription || 'Thiết kế và thi công kiến trúc, nội thất với tâm huyết'}>
  <meta property="og:image" content={heroImageUrl}>
  <meta property="og:image:width" content="1600">
  <meta property="og:image:height" content="630">
  <meta property="og:type" content="website">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${siteName} — Kiến Trúc & Nội Thất`}>
  <meta name="twitter:description" content={h.contactDescription || 'Thiết kế và thi công kiến trúc, nội thất với tâm huyết'}>
  <meta name="twitter:image" content={heroImageUrl}>
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style is:global>
    @import '../styles-new.css';
  </style>
  <style>
    .form-group.has-error input { border-color: #b94a48 !important; }
    .form-group .field-error { display: none; color: #b94a48; font-size: 12px; margin-top: 6px; }
    .form-group.has-error .field-error { display: block; }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <a href="/" class="nav-logo"><img src={navLogoUrl} alt={siteName} class="nav-logo-img" loading="eager" decoding="async"></a>
  <div class="nav-links">
    <a href="/" class="active">Trang Chủ</a>
    <a href="/projects">Dự Án</a>
    <a href="/about-us">Về Chúng Tôi</a>
  </div>
  <a href="#contact" class="nav-cta">LIÊN HỆ ↗</a>
  <button class="nav-toggle" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="nav-mobile">
  <a href="/">Trang Chủ</a>
  <a href="/projects">Dự Án</a>
  <a href="/about-us">Về Chúng Tôi</a>
  <a href="#contact">Liên Hệ</a>
</div>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg" style={`background-image: url('${heroImageUrl}')`}></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-tag">[ KIẾN TRÚC & NỘI THẤT ]</div>
    <h1 class="hero-title">{h.heroTitle || 'ĐIỂM TỰA CỦA KHÔNG GIAN HOÀN MỸ'}</h1>
    <p class="hero-sub">{h.heroSubtitle || 'Kiến tạo không gian với trọn vẹn tâm huyết'}</p>
    <div class="hero-actions">
      <a href="/projects" class="btn-primary">XEM DỰ ÁN ↗</a>
      <a href="#contact" class="btn-ghost">LIÊN HỆ TƯ VẤN</a>
    </div>
  </div>
  <div class="hero-scroll">SCROLL ↓</div>
</section>

<!-- TESTIMONIALS -->
{testimonials.length > 0 && (
  <section class="testimonials-section">
    <div class="section-label">[ KHÁCH HÀNG NÓI GÌ ]</div>
    <div class="testimonials-row">
      {testimonials.map(t => {
        const avatarUrl = getAssetUrl(allAssets, t.fields.avatar?.sys?.id)
          || `https://i.pravatar.cc/48?u=${t.fields.authorName}`;
        return (
          <div class="testi-card">
            <p>"{t.fields.quote}"</p>
            <div class="testi-author">
              <img src={avatarUrl} alt={t.fields.authorName}>
              <div>
                <div class="testi-name">{t.fields.authorName}</div>
                <div class="testi-role">{t.fields.authorTitle}{t.fields.authorCompany ? `, ${t.fields.authorCompany}` : ''}</div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}

<!-- CONTACT -->
<section class="contact-section" id="contact">
  <div class="contact-grid">
    <div class="contact-cell intro-cell">
      <h2>{h.introTitle || 'Điểm tựa của không gian hoàn mỹ'}</h2>
    </div>
    <div class="contact-cell desc-cell">
      <p>{h.introDescription || 'Là người kiến tạo không gian với trọn vẹn tâm huyết, mang đến công trình tinh tế, bền vững và giàu cảm xúc.'}</p>
    </div>
    <div class="contact-cell info-cell">
      <div class="company-name">{h.siteName || 'StopLab'}</div>
      <div class="company-details">
        <div>Điện thoại: {h.contactPhone || '+84 (0) 123 456 789'}</div>
        <div>Email: {h.contactEmail || 'hello@stoplab.vn'}</div>
        <div set:html={(h.footerAddress || '').replace(/\n/g, '<br>')}></div>
      </div>
    </div>
    <div class="contact-cell form-cell">
      <div class="form-title">ĐẶT LỊCH TƯ VẤN THIẾT KẾ</div>
      <div class="contact-form">
        <div class="form-group" id="fg-name">
          <input id="f-name" type="text" placeholder="Họ tên" autocomplete="name" maxlength="80" aria-describedby="err-name">
          <div class="field-error" id="err-name">Nhập họ tên (ít nhất 2 ký tự, chỉ chữ cái và khoảng trắng).</div>
        </div>
        <div class="form-group" id="fg-phone">
          <input id="f-phone" type="tel" placeholder="Số điện thoại" inputmode="tel" autocomplete="tel" aria-describedby="err-phone">
          <div class="field-error" id="err-phone">Nhập đủ chữ số (từ 9 đến 15 số, có thể có khoảng trắng hoặc dấu +).</div>
        </div>
        <div class="form-group" id="fg-email">
          <input id="f-email" type="email" placeholder="Email (tùy chọn)" autocomplete="email" aria-describedby="err-email">
          <div class="field-error" id="err-email">Email không đúng định dạng.</div>
        </div>
        <button type="button" class="submit-btn">Yêu cầu tư vấn</button>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-bg-text">{siteName}</div>
  <div class="footer-left">
    <div>THÀNH LẬP '18</div>
    <div class="footer-copy">BẢO LƯU MỌI QUYỀN.<br>©2024 {siteName}</div>
  </div>
  <div class="footer-center">
    <div>{h.footerTagline || 'XUẤT SẮC // TÍCH HỢP // BỀN VỮNG'}</div>
    <div set:html={(h.footerAddress || '').replace(/\n/g, '<br>')}></div>
  </div>
  <div class="footer-right">
    <div>DANH MỤC</div>
    <div class="footer-links">
      <a href="#">INSTAGRAM</a>
      <a href="#">FACEBOOK</a>
    </div>
    <a href="#">ĐIỀU KHOẢN & BẢO MẬT</a>
  </div>
</footer>

<script>
  // Nav toggle
  const toggle = document.querySelector('.nav-toggle');
  const mobileNav = document.querySelector('.nav-mobile');
  toggle?.addEventListener('click', () => mobileNav?.classList.toggle('active'));
  document.addEventListener('click', e => {
    if (!toggle?.contains(e.target) && !mobileNav?.contains(e.target))
      mobileNav?.classList.remove('active');
  });

  // Scroll animations
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

  // Contact form — field validation
  const SHEET_URL = 'https://script.google.com/macros/s/AKfycbxiRf-SrWQmnw1LOXXLKFOPH0IWBcLC4y6lyoaGYRgjwLRj1xpVh9-QJ-Q1Xy4dydpFQw/exec';

  function isValidName(s) {
    if (s.length < 2 || s.length > 80) return false;
    return /^[\p{L}\s'.-]+$/u.test(s);
  }

  function phoneDigitCount(s) {
    return (s.match(/\d/g) || []).length;
  }

  /** Chỉ kiểm tra đủ chữ số, không ràng buộc đầu số hay mã vùng. */
  function isValidPhoneDigits(s) {
    const n = phoneDigitCount(s);
    return n >= 9 && n <= 15;
  }

  function isValidEmail(s) {
    if (!s) return true;
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(s);
  }

  function setGroupError(groupId, invalid) {
    document.getElementById(groupId)?.classList.toggle('has-error', invalid);
  }

  function syncName() {
    const name = document.getElementById('f-name')?.value.trim() ?? '';
    setGroupError('fg-name', !isValidName(name));
  }

  function syncPhone() {
    const phone = document.getElementById('f-phone')?.value.trim() ?? '';
    setGroupError('fg-phone', !isValidPhoneDigits(phone));
  }

  function syncEmail() {
    const email = document.getElementById('f-email')?.value.trim() ?? '';
    setGroupError('fg-email', email.length > 0 && !isValidEmail(email));
  }

  function validateAll() {
    syncName();
    syncPhone();
    syncEmail();
    const nameOk = isValidName(document.getElementById('f-name')?.value.trim() ?? '');
    const phoneOk = isValidPhoneDigits(document.getElementById('f-phone')?.value.trim() ?? '');
    const emailVal = document.getElementById('f-email')?.value.trim() ?? '';
    const emailOk = isValidEmail(emailVal);
    return nameOk && phoneOk && emailOk;
  }

  document.querySelector('.form-cell .submit-btn')?.addEventListener('click', () => {
    if (!validateAll()) {
      alert('Vui lòng sửa các trường được đánh dấu đỏ.');
      return;
    }

    const name = document.getElementById('f-name')?.value.trim() ?? '';
    const phone = document.getElementById('f-phone')?.value.trim() ?? '';
    const email = document.getElementById('f-email')?.value.trim() ?? '';

    const btn = document.querySelector('.form-cell .submit-btn');
    btn.textContent = 'Đang gửi...';
    btn.disabled = true;
    fetch(SHEET_URL, {
      method: 'POST', mode: 'no-cors',
      body: new URLSearchParams({ name, phone, email })
    });
    btn.textContent = 'Đã gửi ✓';
    document.getElementById('f-name').value = '';
    document.getElementById('f-phone').value = '';
    document.getElementById('f-email').value = '';
    btn.disabled = false;
    ['fg-name', 'fg-phone', 'fg-email'].forEach((id) => document.getElementById(id)?.classList.remove('has-error'));
  });

  document.getElementById('f-name')?.addEventListener('input', syncName);
  document.getElementById('f-name')?.addEventListener('blur', syncName);
  document.getElementById('f-phone')?.addEventListener('input', syncPhone);
  document.getElementById('f-phone')?.addEventListener('blur', syncPhone);
  document.getElementById('f-email')?.addEventListener('input', syncEmail);
  document.getElementById('f-email')?.addEventListener('blur', syncEmail);
</script>

</body>
</html>
